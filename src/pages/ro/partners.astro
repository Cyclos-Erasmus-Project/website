---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, type Language } from "../../i18n/translations";
import assocLogo from "../../assets/assoc.png";
import cslLogo from "../../assets/cssa.png";
import afisLogo from "../../assets/afis.png";
import flvsLogo from "../../assets/vif.png";
import happyImg from "../../assets/happy.png";

const lang: Language = "ro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const t = useTranslations(lang);

const partners = [
    {
        id: "flvs",
        name: "FLVS",
        logo: flvsLogo.src,
        fullName: "Fédérons Les Villes pour la Santé",
        country: "Franța",
        city: "Saint-André-Lez-Lille",
        lead: true,
        description:
            "FLVS este o organizație non-profit recunoscută ca fiind de interes general din 1991. Organizația implementează programul Vivons en Forme (VIF) cu peste 30 de ani de experiență în peste 300 de orașe din Franța. Programul se concentrează pe prevenirea supraponderalității și obezității la copii și s-a extins pentru a sprijini sănătatea, bunăstarea și mediile de viață sănătoase pentru toți, cu un accent deosebit pe membrii defavorizați și vulnerabili ai societății.",
        expertise: [
            "Promovarea sănătății",
            "Metodologie de marketing social",
            "Intervenții comunitare",
            "Programe de schimbare comportamentală",
        ],
        website: null,
    },
    {
        id: "assoc",
        name: "ASSOC",
        fullName:
            "Asociatia Profesionala Neguvernamentala de Asistenta Sociala",
        country: "România",
        city: "Baia Mare",
        logo: assocLogo.src,
        lead: false,
        description:
            "ASSOC este o organizație neguvernamentală înființată în 1995 ca furnizor de servicii sociale. Misiunea lor este de a promova integrarea socială și de a îmbunătăți condițiile de viață ale grupurilor vulnerabile prin educație și muncă. Cu peste 60 de proiecte implementate, ASSOC a dezvoltat servicii educaționale și sociale pentru persoanele cu dizabilități, comunitățile de romi, persoanele în vârstă, migranții și familiile aflate în criză.",
        expertise: [
            "Servicii sociale",
            "Sprijin pentru persoane cu dizabilități",
            "Consiliere vocațională",
            "Servicii de integrare",
        ],
        website: "https://www.assoc.ro",
    },
    {
        id: "afis",
        name: "AFIS",
        logo: afisLogo.src,
        fullName: "Austrian Forum for Integration and Sustainability",
        country: "Austria",
        city: "Viena",
        lead: false,
        description:
            "Forumul Austrian pentru Integrare și Sustenabilitate (AFIS) a fost înființat de experți în managementul proiectelor educaționale internaționale, educație și integrare socială. Organizația își propune să răspundă nevoii crescânde de sprijin educațional incluziv și integrare a tinerilor din medii defavorizate, inclusiv tineri cu dizabilități, tineri migranți și cei din familii dezavantajate economic.",
        expertise: [
            "Management de proiecte educaționale",
            "Împuternicirea tinerilor",
            "Integrare socială",
            "Educație non-formală",
        ],
        website: "https://www.oefis.org",
    },
    {
        id: "csl",
        logo: cslLogo.src,
        name: "Computer Solutions SA",
        fullName: "Computer Solutions SA",
        country: "Grecia",
        city: "Atena",
        lead: false,
        description:
            "Computer Solutions SA este o companie grecească cu expertiză în soluții digitale și dezvoltare tehnologică. Aceștia aduc expertiză tehnică în proiectul CYCLOS, în special în dezvoltarea platformei digitale și a aplicației de învățare care va sprijini obiectivele educaționale ale proiectului.",
        expertise: [
            "Dezvoltare platforme digitale",
            "Soluții e-learning",
            "Integrare tehnologică",
            "Dezvoltare software",
        ],
        website: "https://www.csl.gr",
    },
];
---

<BaseLayout title={t("nav.partners")} lang={lang}>
    <!-- Hero -->
    <section class="relative text-white py-16 md:py-24 overflow-hidden">
        <div class="absolute inset-0">
            <img
                src={happyImg.src}
                alt=""
                class="w-full h-full object-cover object-bottom"
            />
            <div
                class="absolute inset-0 bg-gradient-to-br from-blue-900/80 to-blue-800/80"
            >
            </div>
        </div>
        <div class="container-wide relative z-10">
            <h1 class="text-4xl md:text-5xl font-bold mb-4 drop-shadow-lg">
                {t("partners.title")}
            </h1>
            <p class="text-xl text-blue-100 max-w-3xl drop-shadow-md">
                {t("partners.subtitle")}
            </p>
        </div>
    </section>

    <!-- Partners Map Overview -->
    <section class="section-alt">
        <div class="container-wide">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
                {
                    partners.map((partner) => (
                        <a
                            href={`#${partner.id}`}
                            class="card p-6 hover:shadow-lg transition-all hover:-translate-y-1"
                        >
                            <div class="w-16 h-16 mx-auto mb-3 bg-lime-100 rounded-full flex items-center justify-center overflow-hidden">
                                {partner.logo ? (
                                    <img
                                        src={partner.logo}
                                        alt={partner.name}
                                        class="w-12 h-12 object-contain"
                                    />
                                ) : (
                                    <span class="text-2xl font-bold text-lime-600">
                                        {partner.name.charAt(0)}
                                    </span>
                                )}
                            </div>
                            <h3 class="font-semibold">{partner.name}</h3>
                            <p class="text-sm text-gray-500">
                                {partner.country}
                            </p>
                            {partner.lead && (
                                <span class="inline-block mt-2 text-xs bg-lime-100 text-lime-700 px-2 py-1 rounded-full">
                                    {t("partners.lead")}
                                </span>
                            )}
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Partner Details -->
    <section class="section">
        <div class="container-wide space-y-16">
            {
                partners.map((partner, index) => (
                    <div id={partner.id} class="scroll-mt-24">
                        <div
                            class:list={[
                                "card overflow-hidden",
                                index % 2 === 0 ? "" : "md:flex-row-reverse",
                            ]}
                        >
                            <div class="md:flex">
                                <div class="md:w-1/3 bg-gradient-to-br from-lime-500 to-blue-600 p-8 text-white flex flex-col justify-center">
                                    <div class="w-24 h-24 bg-white/20 rounded-full flex items-center justify-center mb-6 overflow-hidden">
                                        {partner.logo ? (
                                            <img
                                                src={partner.logo}
                                                alt={partner.name}
                                                class="w-20 h-20 object-contain"
                                            />
                                        ) : (
                                            <span class="text-4xl font-bold">
                                                {partner.name.charAt(0)}
                                            </span>
                                        )}
                                    </div>
                                    <h2 class="text-2xl font-bold mb-2">
                                        {partner.name}
                                    </h2>
                                    <p class="text-white/90 text-sm mb-4">
                                        {partner.fullName}
                                    </p>
                                    <div class="space-y-2 text-sm">
                                        <p class="flex items-center">
                                            <svg
                                                class="w-4 h-4 mr-2"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                                />
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                                />
                                            </svg>
                                            {partner.city}, {partner.country}
                                        </p>
                                        {partner.website && (
                                            <a
                                                href={partner.website}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="flex items-center hover:underline"
                                            >
                                                <svg
                                                    class="w-4 h-4 mr-2"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                                                    />
                                                </svg>
                                                {t("partners.website")}
                                            </a>
                                        )}
                                    </div>
                                    {partner.lead && (
                                        <div class="mt-4 inline-block bg-white/20 px-3 py-1 rounded-full text-sm">
                                            {t("partners.lead")}
                                        </div>
                                    )}
                                </div>
                                <div class="md:w-2/3 p-8">
                                    <p class="text-gray-600 mb-6">
                                        {partner.description}
                                    </p>
                                    <h3 class="font-semibold text-lg mb-3">
                                        {t("partners.areasOfExpertise")}
                                    </h3>
                                    <div class="flex flex-wrap gap-2">
                                        {partner.expertise.map((exp) => (
                                            <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm">
                                                {exp}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- Partnership CTA -->
    <section
        class="bg-gradient-to-r from-lime-600 to-blue-600 text-white py-16"
    >
        <div class="container-wide text-center">
            <h2 class="text-3xl font-bold mb-4">
                {t("partners.workingTogether")}
            </h2>
            <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
                {t("partners.workingTogetherDesc")}
            </p>
            <a
                href={`${base}/${lang}/contact/`}
                class="btn bg-white text-lime-700 hover:bg-lime-50"
            >
                {t("nav.contact")}
            </a>
        </div>
    </section>
</BaseLayout>
