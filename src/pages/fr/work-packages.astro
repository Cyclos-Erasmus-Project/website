---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { useTranslations, type Language } from '../../i18n/translations'
import wpImg from '../../assets/wp.png'

const lang: Language = 'fr'
const t = useTranslations(lang)

const workPackages = [
  {
    id: 1,
    title: t('wp.wp1.title'),
    description: 'Coordination globale, assurance qualité et gestion administrative du projet.',
    budget: '45 900 €',
    lead: 'FLVS (France)',
    color: 'primary',
    activities: [
      'Coordination du projet et communication entre partenaires',
      'Assurance qualité et suivi du projet',
      'Gestion financière et reporting',
      'Gestion et atténuation des risques',
      'Organisation des réunions de partenariat'
    ],
    deliverables: [
      'Plan de gestion du projet',
      'Cadre d\'assurance qualité',
      'Rapports d\'avancement',
      'Rapport final du projet'
    ]
  },
  {
    id: 2,
    title: t('wp.wp2.title'),
    description: 'Développement de supports éducatifs et de modules de formation autour du vélo.',
    budget: '52 850 €',
    lead: 'ASSOC (Roumanie)',
    color: 'secondary',
    activities: [
      'Recherche sur le vélo et l\'inclusion sociale',
      'Analyse des besoins des groupes cibles',
      'Développement des contenus de formation',
      'Création d\'un guide pédagogique',
      'Relecture par les pairs et validation'
    ],
    deliverables: [
      'Rapport d\'analyse des besoins',
      'Guide pédagogique (5 langues)',
      'Modules de formation',
      'Compilation de bonnes pratiques'
    ]
  },
  {
    id: 3,
    title: t('wp.wp3.title'),
    description: 'Sessions pratiques de vélo pour les jeunes défavorisés et formation des professionnels.',
    budget: '53 400 €',
    lead: 'AFIS (Autriche)',
    color: 'primary',
    activities: [
      'Sessions pilotes de vélo avec les jeunes',
      'Ateliers de formation pour les professionnels',
      'Activités pratiques de développement des compétences',
      'Formations à la sécurité et à la maintenance du vélo',
      'Sessions de sensibilisation environnementale'
    ],
    deliverables: [
      'Rapports des sessions pilotes',
      'Programme de formation des professionnels',
      'Analyse des retours des participants',
      'Lignes directrices méthodologiques'
    ]
  },
  {
    id: 4,
    title: t('wp.wp4.title'),
    description: 'Développement d\'une plateforme et d\'une application d\'apprentissage numérique dédiées au vélo et à la sensibilisation environnementale.',
    budget: '50 420 €',
    lead: 'Computer Solutions SA (Grèce)',
    color: 'secondary',
    activities: [
      'Conception et développement de la plateforme',
      'Création de modules e-learning',
      'Intégration d\'éléments de gamification',
      'Intégration de contenus multilingues',
      'Tests utilisateurs et amélioration continue'
    ],
    deliverables: [
      'Plateforme d\'apprentissage numérique',
      'Application adaptée aux appareils mobiles',
      'Modules d\'apprentissage interactifs',
      'Documentation utilisateur'
    ]
  },
  {
    id: 5,
    title: t('wp.wp5.title'),
    description: 'Communication, diffusion des résultats et évaluation de la qualité du projet.',
    budget: '47 430 €',
    lead: 'FLVS (France)',
    color: 'primary',
    activities: [
      'Élaboration de la stratégie de communication',
      'Gestion du site web et des réseaux sociaux',
      'Organisation d\'événements de diffusion',
      'Organisation de la conférence finale',
      'Évaluation de l\'impact du projet'
    ],
    deliverables: [
      'Plan de communication',
      'Site web du projet',
      'Supports promotionnels',
      'Rapport d\'évaluation',
      'Recommandations politiques'
    ]
  }
]
---

<BaseLayout title={t('nav.workPackages')} lang={lang}>
  <!-- Hero -->
  <section class="relative text-white py-16 md:py-24 overflow-hidden">
    <div class="absolute inset-0">
            <img src={wpImg.src} alt="" class="w-full h-full object-cover object-center" />
            <div class="absolute inset-0 bg-gradient-to-br from-blue-900/80 to-blue-800/80"></div>
        </div>
        <div class="container-wide relative z-10">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 drop-shadow-lg">{t('wp.title')}</h1>
      <p class="text-xl text-blue-100 max-w-3xl drop-shadow-md">
        {t('wp.subtitle')}
      </p>
    </div>
  </section>

  <!-- Overview Cards -->
  <section class="section-alt">
    <div class="container-wide">
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {workPackages.map((wp) => (
          <a href={`#wp${wp.id}`} class="card p-4 text-center hover:shadow-lg transition-all hover:-translate-y-1">
            <div class:list={[
              'w-12 h-12 mx-auto mb-3 rounded-full flex items-center justify-center text-white font-bold',
              wp.color === 'primary' ? 'bg-lime-600' : 'bg-blue-600'
            ]}>
              {wp.id}
            </div>
            <h3 class="font-semibold text-sm">LT{wp.id}</h3>
            <p class="text-xs text-gray-500 mt-1">{wp.budget}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Detailed Work Packages -->
  <section class="section">
    <div class="container-wide space-y-12">
      {workPackages.map((wp) => (
        <div id={`wp${wp.id}`} class="scroll-mt-24">
          <div class:list={[
            'card overflow-hidden border-l-4',
            wp.color === 'primary' ? 'border-lime-500' : 'border-blue-500'
          ]}>
            <div class="p-8">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
                <div class="flex items-center">
                  <div class:list={[
                    'w-14 h-14 rounded-full flex items-center justify-center text-white font-bold text-xl mr-4',
                    wp.color === 'primary' ? 'bg-lime-600' : 'bg-blue-600'
                  ]}>
                    {wp.id}
                  </div>
                  <div>
                    <h2 class="text-2xl font-bold">{wp.title}</h2>
                    <p class="text-gray-500">{t('wp.ledBy')} {wp.lead}</p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="text-2xl font-bold text-lime-600">{wp.budget}</p>
                  <p class="text-sm text-gray-500">{t('wp.budgetAllocation')}</p>
                </div>
              </div>

              <p class="text-gray-600 mb-8">{wp.description}</p>

              <div class="grid md:grid-cols-2 gap-8">
                <div>
                  <h3 class="font-semibold text-lg mb-4 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-lime-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                    </svg>
                    {t('wp.activities')}
                  </h3>
                  <ul class="space-y-2">
                    {wp.activities.map((activity) => (
                      <li class="flex items-start">
                        <svg class="w-5 h-5 mr-2 text-green-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class="text-gray-600">{activity}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3 class="font-semibold text-lg mb-4 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    {t('wp.deliverables')}
                  </h3>
                  <ul class="space-y-2">
                    {wp.deliverables.map((deliverable) => (
                      <li class="flex items-start">
                        <svg class="w-5 h-5 mr-2 text-blue-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                        <span class="text-gray-600">{deliverable}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Budget Overview -->
  <section class="section-alt">
    <div class="container-narrow">
      <h2 class="text-center mb-8">{t('wp.budgetOverview')}</h2>
      <div class="card p-8">
        <div class="space-y-4">
          {workPackages.map((wp) => (
            <div class="flex items-center">
              <span class="w-20 text-sm font-medium">LT{wp.id}</span>
              <div class="flex-grow mx-4">
                <div class="h-6 bg-gray-100 rounded-full overflow-hidden">
                  <div
                    class:list={[
                      'h-full rounded-full',
                      wp.color === 'primary' ? 'bg-lime-500' : 'bg-blue-500'
                    ]}
                    style={`width: ${(parseFloat(wp.budget.replace('€', '').replace(',', '')) / 250000 * 100).toFixed(1)}%`}
                  ></div>
                </div>
              </div>
              <span class="w-24 text-right text-sm font-medium">{wp.budget}</span>
            </div>
          ))}
        </div>
        <div class="border-t mt-6 pt-6 flex justify-between items-center">
          <span class="font-bold text-lg">{t('wp.totalBudget')}</span>
          <span class="font-bold text-2xl text-lime-600">€250,000</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
