---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, type Language } from "../../i18n/translations";
import aboutImg from "../../assets/about.png";

const lang: Language = "fr";
const t = useTranslations(lang);

const objectives = [
    "Promouvoir l'inclusion sociale des jeunes en situation de vulnérabilité grâce à la pratique du vélo.",
    "Sensibiliser aux enjeux environnementaux et encourager des choix de mobilité plus durables.",
    "Aider les jeunes à gagner en autonomie et en indépendance dans leur vie quotidienne.",
    "Renforcer les compétences, la confiance en soi et l'employabilité des jeunes.",
    "Doter les professionnels de la jeunesse d'outils pour organiser des activités cyclistes inclusives.",
    "Développer une plateforme numérique dédiée à l'apprentissage et à la sensibilisation.",
];

const targetGroups = [
    {
        icon: "users",
        title: t("about.target.youth"),
        desc: "Jeunes confrontés à des obstacles à l'emploi, notamment les jeunes en situation de handicap, issus de l'immigration ou de milieux socio-économiques défavorisés.",
    },
    {
        icon: "briefcase",
        title: t("about.target.workers"),
        desc: "Professionnels organisant des activités et des actions en faveur de jeunes en situation de vulnérabilité.",
    },
    {
        icon: "building",
        title: t("about.target.stakeholders"),
        desc: "Structures engagées dans l'inclusion des jeunes et la promotion de la mobilité durable.",
    },
];
---

<BaseLayout title={t("nav.about")} lang={lang}>
    <!-- Hero -->
    <section class="relative text-white py-16 md:py-24 overflow-hidden">
        <div class="absolute inset-0">
            <img
                src={aboutImg.src}
                alt=""
                class="w-full h-full object-cover object-center"
            />
            <div
                class="absolute inset-0 bg-gradient-to-br from-blue-900/80 to-blue-800/80"
            >
            </div>
        </div>
        <div class="container-wide relative z-10">
            <h1 class="text-4xl md:text-5xl font-bold mb-4 drop-shadow-lg">
                {t("about.title")}
            </h1>
            <p class="text-xl text-blue-100 max-w-3xl drop-shadow-md">
                {t("about.background.text")}
            </p>
        </div>
    </section>

    <!-- Project Overview -->
    <section class="section">
        <div class="container-narrow">
            <h2 class="mb-8">{t("about.background.title")}</h2>
            <div class="prose prose-lg max-w-none text-gray-600">
                <p>
                    CYCLOS (Youth Cycling for Inclusion) est un projet de partenariat de
                    coopération Erasmus+ (KA220-YOU) qui réunit quatre organisations issues
                    de France, de Roumanie, d'Autriche et de Grèce. Le projet répond à un
                    enjeu majeur : de nombreux jeunes en situation de vulnérabilité
                    rencontrent des obstacles importants à l'emploi et à l'insertion
                    sociale, la mobilité constituant l'un des freins principaux.
                </p>
                <p>
                    En s'appuyant sur le vélo comme outil d'inclusion,
                    CYCLOS vise à aider ces jeunes à surmonter les difficultés liées à
                    la mobilité, à développer des compétences pratiques, à
                    renforcer leur confiance en eux et à gagner en autonomie.
                    Parallèlement, le projet encourage la sensibilisation aux
                    enjeux environnementaux et la promotion de modes de transport durables.
                </p>
                <p>
                    Le projet prévoit la création de ressources pédagogiques, l'organisation
                    de sessions pratiques autour du vélo, le développement d'une plateforme
                    numérique d'apprentissage ainsi que la mise en place de formations
                    destinées aux professionnels de la jeunesse dans les pays partenaires.
                </p>
            </div>
        </div>
    </section>

    <!-- Objectives -->
    <section class="section-alt">
        <div class="container-wide">
            <h2 class="text-center mb-12">{t("about.objectives.title")}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    objectives.map((objective, index) => (
                        <div class="card p-6 flex items-start">
                            <span class="flex-shrink-0 w-8 h-8 bg-lime-100 text-lime-700 rounded-full flex items-center justify-center font-bold mr-4">
                                {index + 1}
                            </span>
                            <p class="text-gray-700">{objective}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Timeline -->
    <section class="section">
        <div class="container-narrow">
            <h2 class="text-center mb-12">{t("about.timeline.title")}</h2>
            <div class="relative">
                <div
                    class="absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-lime-200"
                >
                </div>
                <div class="space-y-12">
                    <div class="relative flex items-center">
                        <div class="flex-1 text-right pr-8">
                            <h3 class="font-semibold text-lg">
                                {t("about.timeline.start")}
                            </h3>
                            <p class="text-lime-600 font-bold text-xl">
                                September 2025
                            </p>
                        </div>
                        <div class="w-4 h-4 bg-lime-600 rounded-full z-10">
                        </div>
                        <div class="flex-1 pl-8"></div>
                    </div>
                    <div class="relative flex items-center">
                        <div class="flex-1 text-right pr-8"></div>
                        <div class="w-4 h-4 bg-lime-400 rounded-full z-10">
                        </div>
                        <div class="flex-1 pl-8">
                            <h3 class="font-semibold text-lg">
                                {t("about.timeline.duration")}
                            </h3>
                            <p class="text-gray-600">de travail collaboratif</p>
                        </div>
                    </div>
                    <div class="relative flex items-center">
                        <div class="flex-1 text-right pr-8">
                            <h3 class="font-semibold text-lg">
                                {t("about.timeline.end")}
                            </h3>
                            <p class="text-lime-600 font-bold text-xl">
                                February 2028
                            </p>
                        </div>
                        <div class="w-4 h-4 bg-lime-600 rounded-full z-10">
                        </div>
                        <div class="flex-1 pl-8"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Target Audience -->
    <section class="section-alt">
        <div class="container-wide">
            <h2 class="text-center mb-12">{t("about.target.title")}</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {
                    targetGroups.map((group) => (
                        <div class="card p-8 text-center">
                            <div class="w-16 h-16 mx-auto mb-4 bg-blue-100 rounded-full flex items-center justify-center">
                                {group.icon === "users" && (
                                    <svg
                                        class="w-8 h-8 text-blue-600"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                                        />
                                    </svg>
                                )}
                                {group.icon === "briefcase" && (
                                    <svg
                                        class="w-8 h-8 text-blue-600"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                        />
                                    </svg>
                                )}
                                {group.icon === "building" && (
                                    <svg
                                        class="w-8 h-8 text-blue-600"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                                        />
                                    </svg>
                                )}
                            </div>
                            <h3 class="font-semibold text-lg mb-2">
                                {group.title}
                            </h3>
                            <p class="text-gray-600">{group.desc}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Funding Info -->
    <section class="section bg-blue-50">
        <div class="container-narrow text-center">
            <div class="flex justify-center mb-6">
                <img
                    src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/flag-erasmus.png`}
                    alt="Co-funded by the European Union - Erasmus+ Programme"
                    class="h-20 w-auto"
                />
            </div>
            <h2 class="text-2xl font-bold mb-4">
                Financé par l'Union européenne
            </h2>
            <p class="text-gray-600 max-w-2xl mx-auto">
                CYCLOS est un projet de partenariat de coopération financé dans le cadre
                du programme Erasmus+ (KA220-YOU), pour un budget total de
                250 000 €. Le projet est coordonné par la FLVS (France), en
                partenariat avec des organisations de Roumanie, d'Autriche et de
                Grèce.
            </p>
        </div>
    </section>
</BaseLayout>
